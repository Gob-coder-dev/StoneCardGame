[gd_scene load_steps=5 format=3 uid="uid://level_select"]

[ext_resource type="Script" path="res://scripts/ui/LevelSelectController.gd" id="1_lvlsel"]
[ext_resource type="Script" path="res://scripts/ui/ParchmentBackground.gd" id="2_parchment"]
[ext_resource type="Script" path="res://scripts/ui/input/TouchButton.gd" id="3_touch_button"]
[ext_resource type="Script" path="res://scripts/ui/input/TouchScrollContainer.gd" id="4_touch_scroll"]

[node name="LevelSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_lvlsel")

[node name="Background" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
script = ExtResource("2_parchment")

[node name="Root" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 40.0
offset_top = 80.0
offset_right = -40.0
offset_bottom = -40.0
theme_override_constants/separation = 36

[node name="Header" type="HBoxContainer" parent="Root"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="CloseButton" type="Button" parent="Root/Header"]
layout_mode = 2
script = ExtResource("3_touch_button")
custom_minimum_size = Vector2(110, 110)
theme_override_font_sizes/font_size = 48
text = "×"

[node name="TitleLabel" type="Label" parent="Root/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.91, 0.78, 0.47, 1)
theme_override_font_sizes/font_size = 58
text = "CHOISIR UN ADVERSAIRE"
horizontal_alignment = 1
vertical_alignment = 1

[node name="NPCListScroll" type="ScrollContainer" parent="Root"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
script = ExtResource("4_touch_scroll")

[node name="NPCList" type="VBoxContainer" parent="Root/NPCListScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 20

[node name="ProfilePanel" type="PanelContainer" parent="Root"]
layout_mode = 2
visible = false

[node name="ProfileContent" type="VBoxContainer" parent="Root/ProfilePanel"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="NPCName" type="Label" parent="Root/ProfilePanel/ProfileContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.9, 0.78, 1)
theme_override_font_sizes/font_size = 48
text = "Nom NPC"
horizontal_alignment = 1

[node name="NPCQuote" type="Label" parent="Root/ProfilePanel/ProfileContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.82, 0.74, 0.58, 1)
theme_override_font_sizes/font_size = 32
text = "Citation"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Difficulty" type="Label" parent="Root/ProfilePanel/ProfileContent"]
layout_mode = 2
theme_override_font_sizes/font_size = 34
text = "Niveau : ?"
horizontal_alignment = 1

[node name="FightButton" type="Button" parent="Root/ProfilePanel/ProfileContent"]
layout_mode = 2
script = ExtResource("3_touch_button")
custom_minimum_size = Vector2(0, 130)
text = "⚔  AFFRONTER"
disabled = true
